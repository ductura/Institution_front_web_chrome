{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install -g pnpm@10.33.0 && pnpm install --frozen-lockfile && pnpm --dir src/client install --ignore-workspace --frozen-lockfile --ignore-scripts",
  "buildCommand": "pnpm --filter @ductura/app run build",
  "outputDirectory": "packages/app/dist",
  "redirects": [
    { "source": "/", "destination": "/app/web/", "permanent": false },
    { "source": "/app/web", "destination": "/app/web/", "permanent": false },
    { "source": "/app/chrome", "destination": "/app/chrome/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/api/v1/:path*", "destination": "https://ZAMIJENI-institution-server.invalid/api/v1/:path*" },
    { "source": "/app/:base(web|chrome)/assets/:file*", "destination": "/assets/:file*" },
    { "source": "/app/:base(web|chrome)/:file(.+\\.[A-Za-z0-9]+)", "destination": "/:file" },
    { "source": "/app/:base(web|chrome)/:path*", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/app/:base(web|chrome)/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
