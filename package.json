{
  "name": "@ductura/institution-front-web-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura prioritetni frontend za Google Chrome na računalu",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "pnpm --filter @ductura/app run build",
    "dev": "pnpm --filter @ductura/app run dev",
    "start": "pnpm --filter @ductura/app run start",
    "test": "npm run test:helpers && npm run test:functional && npm run test:editor6e",
    "test:helpers": "node --test \"test/unit/*.test.js\"",
    "test:functional": "playwright test",
    "test:editor6e": "playwright test --config src/components/editor/triggers/browser/playwright.config.test.cjs",
    "next:dev": "next dev -p 3000",
    "next:build": "next build",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "yaml": "2.9.1"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
