{
  "name": "@ductura/institution-front-web-chrome",
  "version": "0.1.0",
  "private": true,
  "description": "Ductura prioritetni frontend za Google Chrome na računalu",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "build": "pnpm --filter @ductura/app run build",
    "dev": "pnpm run build && node dev-server.mjs",
    "test": "npm run test:helpers && npm run test:functional",
    "test:helpers": "node --test \"test/unit/*.test.js\"",
    "test:functional": "playwright test",
    "test:e2e:ductus": "playwright test --config playwright.ductus.config.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "yaml": "2.9.1"
  }
}
