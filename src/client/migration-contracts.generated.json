  "institution.course-groups.get": {
    "path": "/api/v1/institution/courses/{courseId}/groups",
    "method": "GET",
    "params": {
      "type": "object",
      "required": [
        "courseId"
      ],
      "properties": {
        "courseId": {
          "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$",
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "responses": {
      "200": {
        "content": {
          "application/json": {
            "schema": {
              "additionalProperties": false,
              "type": "object",
              "required": [
                "groups"
              ],
              "properties": {
                "groups": {
                  "type": "array",
                  "items": {
                    "additionalProperties": false,
                    "type": "object",
                    "required": [
                      "id",
                      "name",
                      "teachers",
                      "students"
                    ],
                    "properties": {
                      "id": {
                        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
                        "type": "string"
                      },
                      "name": {
                        "minLength": 1,
                        "type": "string"
                      },
                      "teachers": {
                        "type": "array",
                        "items": {
                          "additionalProperties": false,
                          "type": "object",
                          "required": [
                            "id",
                            "givenName",
                            "familyName"
                          ],
                          "properties": {
                            "id": {
                              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}(?![\\s\\S])",
                              "type": "string"
                            },
                            "givenName": {
                              "pattern": "^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF]){1,255}(?![\\s\\S])",
                              "type": "string"
                            },
                            "familyName": {
                              "pattern": "^(?:[\\uD800-\\uDBFF][\\uDC00-\\uDFFF]|[^\\uD800-\\uDFFF]){1,255}(?![\\s\\S])",
                              "type": "string"
                            }
                          }
                        }
                      },
                      "students": {
                        "minimum": 0,
                        "maximum": 9007199254740991,
                        "type": "integer"
                      }
                    }
                  }
