{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  "include": ["*.ts"],
  // Ported from Ductus 0cdb0f1 and checked by tsconfig.ductus.json instead.
  "exclude": ["comments.ts", "comments.test.ts", "revision-requests.ts", "revision-requests.test.ts"]
}
