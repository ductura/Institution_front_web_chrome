// PENDING (not run by Playwright: the name does not end in .spec.ts). WEB-V14-SHEET-PAGE: the student opens a spreadsheet
// work, writes a formula, reloads, and the sum is the same. Like the system tests it needs the real local stack (fake
// AAI@EduHr, demo-student) with a seeded assignment of the kind spreadsheet, which the server seed does not have until
// SRV-V14-KIND-ENUM v2 is merged and seeded. It is renamed to sheet-student.spec.ts (and moved under the stack of
// e2e/sistem if the owner wants it in `pnpm test:sistem`) by the task that brings that seed; until then no red test.
// Not run in the cloud (no stack, no Docker). Invented data only.
import { expect, test, type Page } from "@playwright/test";

import { signInDemoStudent } from "../../../e2e/sistem/student";

const SEED_TITLE = "Tablica: kućni proračun"; // ASSUMPTION: the seed's spreadsheet assignment

async function openSheetWork(page: Page) {
  await signInDemoStudent(page);
  await page.getByRole("link", { name: new RegExp(SEED_TITLE) }).first().click();
  const start = page.getByRole("button", { name: /Započni rad/ });
  if (await start.isVisible().catch(() => false)) await start.click();
  const grid = page.getByRole("grid", { name: /Tablica/ });
  await expect(grid).toBeVisible({ timeout: 20_000 });
  return grid;
}

const cell = (page: Page, ref: string) => page.locator(`[data-cell="${ref}"]`);

async function fill(page: Page, ref: string, text: string) {
  await cell(page, ref).focus();
  await page.keyboard.press("F2");
  await page.keyboard.type(text);
  await page.keyboard.press("Enter");
}

test("a formula written by the student is still there, with the same sum, after a reload", async ({ page }) => {
  await openSheetWork(page);
  await fill(page, "A1", "2");
  await fill(page, "A2", "3");
  await fill(page, "A3", "=SUM(A1:A2)");
  await expect(cell(page, "A3")).toContainText("5");
  // The save is claimed only as far as it went: on the device first, on the server after a signed receipt.
  await expect(page.getByText(/Spremljeno na (uređaju|poslužitelju)/)).toBeVisible({ timeout: 20_000 });
  await page.reload();
  await expect(page.getByRole("grid", { name: /Tablica/ })).toBeVisible({ timeout: 20_000 });
  await expect(cell(page, "A3")).toContainText("5");
});
