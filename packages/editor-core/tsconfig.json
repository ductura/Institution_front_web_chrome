{
  "extends": "../ui/tsconfig.json",
  "compilerOptions": {
    // Ported verbatim from Ductus, whose tsconfig has no noUncheckedIndexedAccess
    // (same choice as src/domain/tsconfig.json, DAN-990).
    "noUncheckedIndexedAccess": false,
    // Tests read JSON vectors and the faculty citation style, as in Ductus.
    "resolveJsonModule": true,
    // Two sources read the Croatian catalogue through the Ductus "@/" alias;
    // it lives in src/lib/i18n here.
    "paths": {
      "@/lib/i18n/*": ["../../src/lib/i18n/*"]
    }
  },
  "include": ["src", "vitest.config.ts"],
  // Testovi koji uvoze neportirani kod (@/adapters, @/components/editor/sources, server/auth/principal); do PR-a koji ga vrati (ZEL-W1, c.7027096433).
  "exclude": ["node_modules",
    "src/editor/source.property.test.ts",
    "src/editor/source.test.ts",
    "src/journal/sign-out.test.ts"]
}
